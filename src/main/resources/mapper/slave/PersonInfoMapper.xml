<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zjw.mapper.PersonInfoMapper">

    <!-- 结果映射 -->
    <resultMap id="PersonInfoResultMap" type="com.zjw.entity.PersonInfo">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="age" property="age"/>
    </resultMap>

    <!-- 基础查询SQL -->
    <sql id="baseSelect">
        SELECT id, name, age FROM person_info
    </sql>

    <!-- 查询所有 -->
    <select id="selectList" resultMap="PersonInfoResultMap">
        <include refid="baseSelect"/>
        ORDER BY id DESC
    </select>

    <!-- 分页查询 -->
    <select id="selectPage" resultMap="PersonInfoResultMap">
        <include refid="baseSelect"/>
        ORDER BY id DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="PersonInfoResultMap">
        <include refid="baseSelect"/>
        WHERE id = #{id}
    </select>

    <!-- 根据姓名查询 -->
    <select id="selectByName" resultMap="PersonInfoResultMap">
        <include refid="baseSelect"/>
        WHERE name = #{name}
    </select>

    <!-- 插入数据 -->
    <insert id="insert">
        INSERT INTO person_info (id, name, age)
        VALUES (#{id}, #{name}, #{age})
    </insert>

    <!-- 更新数据 -->
    <update id="update">
        UPDATE person_info
        SET name = #{name}, age = #{age}
        WHERE id = #{id}
    </update>

    <!-- 删除数据 -->
    <delete id="delete">
        DELETE FROM person_info WHERE id = #{id}
    </delete>

    <!-- 查询总数 -->
    <select id="count" resultType="java.lang.Long">
        SELECT COUNT(*) FROM person_info
    </select>

</mapper>
