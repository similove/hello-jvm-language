<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zjw.mapper.slave.OrderMapper">

    <!-- 结果映射 -->
    <resultMap id="OrderResultMap" type="com.zjw.entity.Order">
        <id column="id" property="id"/>
        <result column="order_sin" property="orderSin"/>
        <result column="order_desc" property="orderDesc"/>
    </resultMap>

    <!-- 基础查询SQL -->
    <sql id="baseSelect">
        SELECT id, order_sin, order_desc FROM "order"
    </sql>

    <!-- 查询所有 -->
    <select id="selectList" resultMap="OrderResultMap">
        <include refid="baseSelect"/>
        ORDER BY id DESC
    </select>

    <!-- 分页查询 -->
    <select id="selectPage" resultMap="OrderResultMap">
        <include refid="baseSelect"/>
        ORDER BY id DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="OrderResultMap">
        <include refid="baseSelect"/>
        WHERE id = #{id}
    </select>

    <!-- 根据订单号查询 -->
    <select id="selectByOrderSin" resultMap="OrderResultMap">
        <include refid="baseSelect"/>
        WHERE order_sin = #{orderSin}
    </select>

    <!-- 插入数据 -->
    <insert id="insert">
        INSERT INTO "order" (id, order_sin, order_desc)
        VALUES (#{id}, #{orderSin}, #{orderDesc})
    </insert>

    <!-- 更新数据 -->
    <update id="update">
        UPDATE "order"
        SET order_sin = #{orderSin}, order_desc = #{orderDesc}
        WHERE id = #{id}
    </update>

    <!-- 删除数据 -->
    <delete id="delete">
        DELETE FROM "order" WHERE id = #{id}
    </delete>

    <!-- 查询总数 -->
    <select id="count" resultType="java.lang.Long">
        SELECT COUNT(*) FROM "order"
    </select>

</mapper>
